{
  "name": "shoppingfeed/signal",
  "description": "Unix signal handler that allow registering multiples callback on the same signal",
  "keywords": ["unix", "posix", "signal", "pcntl", "handler"],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "ShoppingFeed\\Signal\\": "src/"
    }
  },
  "autoload-dev": {
    "files": [
      "test/unit/HandlerTestCase.php"
    ],
    "psr-4": {
      "ShoppingFeed\\Signal\\": "test/unit/"
    }
  },
  "require-dev": {
    "ext-pcntl": "*",
    "phpunit/phpunit": "^10.0",
    "laminas/laminas-servicemanager": "^3.0",
    "shoppingfeed/coding-style-php": "^2.0",
    "overtrue/phplint": "^1.1",
    "phpstan/phpstan": "^2.1"
  },
  "repositories": {
  "packagist.org": false,
  "private-packagist": {
    "type": "composer",
    "url": "https://repo.packagist.com/shoppingfeed/"
  }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpunit": "vendor/bin/phpunit",
    "phpcs": "vendor/bin/sfcs --progress -vvv -- src test/unit",
    "phpcsfix": "vendor/bin/sfcs --progress -vvv --autofix -- src test/unit",
    "phplint": "vendor/bin/phplint src --cache=build/phplint.cache",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test": [
      "@phplint",
      "@phpunit",
      "@phpstan",
      "@phpcs"
    ]
  }
}
